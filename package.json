{
  "name": "clearcv",
  "version": "0.5.4",
  "private": true,
  "description": "A local-first, open-source CV workspace.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --port 4201",
    "start": "node scripts/serve.mjs --port 4201",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --dir dist --port 4201",
    "test": "node --test",
    "pretest": "node scripts/prepare-assets.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "prestart": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "dictionary-en-gb": "3.0.0",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0",
    "typo-js": "1.3.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  }
}
